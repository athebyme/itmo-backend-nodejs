    <style>
        :root {
            --primary: #5d5fef;
            --primary-dark: #4849d3;
            --secondary: #14b8a6;
            --dark: #1e293b;
            --light: #f8fafc;
            --light-gray: #e2e8f0;
            --radius: 0.5rem;
            --shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
            --transition: all 0.3s ease;
        }
        
        body, html {
            font-family: 'Inter', 'Segoe UI', Roboto, -apple-system, BlinkMacSystemFont, sans-serif;
            background-color: var(--light);
            color: var(--dark);
            margin: 0;
            padding: 0;
        }
        
        .layout {
            display: flex;
            min-height: calc(100vh - 56px - 60px);
            position: relative;
            padding: 1.5rem;
            gap: 1.5rem;
            margin: 0 auto;
            max-width: 1440px;
        }
        
        .main {
            flex: 1;
            background-color: white;
            border-radius: var(--radius);
            box-shadow: var(--shadow);
            padding: 1.5rem;
            height: fit-content;
            transition: var(--transition);
        }
        
        .section__title {
            font-size: 1.5rem;
            margin-bottom: 1.25rem;
            position: relative;
            padding-bottom: 0.75rem;
        }
        
        .section__title::after {
            content: "";
            position: absolute;
            bottom: 0;
            left: 0;
            height: 3px;
            width: 40px;
            background-color: var(--primary);
            border-radius: 4px;
        }
        
        .card {
            border: none;
            border-radius: var(--radius);
            box-shadow: var(--shadow);
            margin-bottom: 1.5rem;
        }
        
        .card-header {
            background-color: var(--primary);
            color: white;
            font-weight: 500;
            border-top-left-radius: var(--radius) !important;
            border-top-right-radius: var(--radius) !important;
        }
        
        .articul-input {
            border: 1px solid var(--light-gray);
            padding: 0.75rem;
            border-radius: var(--radius);
            width: 100%;
            transition: var(--transition);
        }
        
        .articul-input:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(93, 95, 239, 0.2);
            outline: none;
        }
        
        .btn-primary {
            background-color: var(--primary);
            border: none;
            border-radius: var(--radius);
            padding: 0.75rem 1.5rem;
            font-weight: 500;
            transition: var(--transition);
        }
        
        .btn-primary:hover {
            background-color: var(--primary-dark);
        }
        
        .result-container {
            background-color: #f8f9fa;
            border-radius: var(--radius);
            padding: 1.5rem;
            margin-top: 1.5rem;
        }
        
        .prop-item {
            display: flex;
            margin-bottom: 0.75rem;
            border-bottom: 1px solid var(--light-gray);
            padding-bottom: 0.75rem;
        }
        
        .prop-name {
            width: 150px;
            font-weight: 600;
            color: var(--primary);
        }
        
        .prop-value {
            flex: 1;
            font-family: monospace;
            background-color: #f1f1f1;
            padding: 0.25rem 0.5rem;
            border-radius: 4px;
        }
        
        .examples-container {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 1rem;
            margin-bottom: 2rem;
        }
        
        .example-card {
            border: 1px solid var(--light-gray);
            border-radius: var(--radius);
            padding: 1rem;
            cursor: pointer;
            transition: var(--transition);
        }
        
        .example-card:hover {
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(93, 95, 239, 0.1);
        }
        
        .example-title {
            font-weight: 600;
            margin-bottom: 0.5rem;
            color: var(--primary);
        }
        
        .explanation {
            background-color: rgba(93, 95, 239, 0.05);
            border-left: 4px solid var(--primary);
            padding: 1rem;
            margin-bottom: 1.5rem;
            border-radius: 0 var(--radius) var(--radius) 0;
        }
        
        /* Стили для визуализации артикула */
        .articul-visualization {
            display: flex;
            flex-wrap: wrap;
            gap: 0.25rem;
            margin: 1.5rem 0;
            justify-content: center;
        }
        
        .articul-part {
            display: flex;
            flex-direction: column;
            align-items: center;
            border: 1px solid #e2e8f0;
            border-radius: 4px;
            padding: 0.5rem;
            min-width: 60px;
            background-color: #f8fafc;
        }
        
        .part-value {
            font-size: 1.25rem;
            font-weight: 700;
        }
        
        .part-label {
            font-size: 0.75rem;
            color: #64748b;
            margin-top: 0.25rem;
        }
        
        .part-prod-id { border-color: #3b82f6; background-color: rgba(59, 130, 246, 0.1); }
        .part-mp-id { border-color: #10b981; background-color: rgba(16, 185, 129, 0.1); }
        .part-clone-id { border-color: #f59e0b; background-color: rgba(245, 158, 11, 0.1); }
        .part-client-id { border-color: #8b5cf6; background-color: rgba(139, 92, 246, 0.1); }
        .part-version { border-color: #ec4899; background-color: rgba(236, 72, 153, 0.1); }
        .part-seller-prefix { border-color: #ef4444; background-color: rgba(239, 68, 68, 0.1); }
        .part-sx-id { border-color: #6366f1; background-color: rgba(99, 102, 241, 0.1); }
    </style>
