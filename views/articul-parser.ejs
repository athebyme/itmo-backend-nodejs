                                        <div class="part-value">YYYY</div>
                                        <div class="part-label">prod_id</div>
                                    </div>
                                    <div class="articul-part part-mp-id">
                                        <div class="part-value">M</div>
                                        <div class="part-label">mp_id</div>
                                    </div>
                                    <div class="articul-part part-clone-id">
                                        <div class="part-value">N</div>
                                        <div class="part-label">clone_id</div>
                                    </div>
                                    <div class="articul-part part-client-id">
                                        <div class="part-value">D</div>
                                        <div class="part-label">client_id</div>
                                    </div>
                                    <div class="articul-part part-version">
                                        <div class="part-value">S</div>
                                        <div class="part-label">version</div>
                                    </div>
                                    <div class="articul-part part-seller-prefix">
                                        <div class="part-value">S</div>
                                        <div class="part-label">seller_prefix</div>
                                    </div>
                                    <div class="articul-part part-sx-id">
                                        <div class="part-value">XXXX</div>
                                        <div class="part-label">sx_id</div>
                                    </div>
                                </div>
                                <p><strong>Где:</strong></p>
                                <ul>
                                    <li><code>YYYY</code> - год добавления товара (4 цифры)</li>
                                    <li><code>M</code> - маркетплейс (буква: Z=Озон, W=Wildberries)</li>
                                    <li><code>N</code> - номер варианта (цифра)</li>
                                    <li><code>D</code> - номер департамента (буква)</li>
                                    <li><code>S</code> - статус товара (цифра)</li>
                                    <li><code>S</code> - сегмент (буква)</li>
                                    <li><code>XXXX</code> - уникальный идентификатор</li>
                                </ul>
                                <p class="mb-0">Пример: <code>2025W1A3Bsku-12345</code></p>
                            </div>
                        </div>
                    </div>
                    
                    <div class="col-md-6">
                        <div class="card">
                            <div class="card-header">
                                <h5 class="card-title m-0">Исходный сложный формат</h5>
                            </div>
                            <div class="card-body">
                                <div class="articul-visualization">
                                    <div class="articul-part part-prod-id">
                                        <div class="part-value">NNNN</div>
                                        <div class="part-label">prod_id</div>
                                    </div>
                                    <div class="articul-part part-mp-id">
                                        <div class="part-value">L</div>
                                        <div class="part-label">mp_id</div>
                                    </div>
                                    <div class="articul-part part-clone-id">
                                        <div class="part-value">N</div>
                                        <div class="part-label">clone_id</div>
                                    </div>
                                    <div class="articul-part part-client-id">
                                        <div class="part-value">L</div>
                                        <div class="part-label">client_id</div>
                                    </div>
                                    <div class="articul-part part-version">
                                        <div class="part-value">N</div>
                                        <div class="part-label">version</div>
                                    </div>
                                    <div class="articul-part part-seller-prefix">
                                        <div class="part-value">L</div>
                                        <div class="part-label">seller_prefix</div>
                                    </div>
                                    <div class="articul-part part-sx-id">
                                        <div class="part-value">XXXX</div>
                                        <div class="part-label">sx_id</div>
                                    </div>
                                </div>
                                <p><strong>Где:</strong></p>
                                <ul>
                                    <li><code>NNNN</code> - цифровой префикс</li>
                                    <li><code>L</code> - буква маркетплейса</li>
                                    <li><code>N</code> - номер клона</li>
                                    <li><code>L</code> - буква клиента</li>
                                    <li><code>N</code> - номер версии</li>
                                    <li><code>L</code> - префикс поставщика</li>
                                    <li><code>XXXX</code> - идентификатор товара у поставщика</li>
                                </ul>
                                <p class="mb-0">Пример: <code>8457Z1C1A0t-00009990</code></p>
