<div class="layout">
    <main class="main">
        <section class="section">
            <h2 class="section__title">Конвертер валют</h2>
            <p class="section__text">Используйте этот инструмент для проверки стоимости криптовалют в разных валютах.</p>

            <div class="converter-widget mt-4">
                <div class="card">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">Конвертер криптовалют</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label for="amountInput" class="form-label">Количество</label>
                            <input type="number" class="form-control" id="amountInput" value="1" min="0.00000001" step="0.00000001">
                        </div>
                        <div class="mb-3">
                            <label for="cryptoSelect" class="form-label">Выберите криптовалюту</label>
                            <select class="form-select" id="cryptoSelect">
                                <option value="BTCUSDT" selected>Bitcoin (BTC)</option>
                                <option value="ETHUSDT">Ethereum (ETH)</option>
                                <option value="BNBUSDT">Binance Coin (BNB)</option>
                                <option value="SOLUSDT">Solana (SOL)</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label for="currencySelect" class="form-label">Выберите валюту конвертации</label>
                            <select class="form-select" id="currencySelect">
                                <option value="usd" selected>Доллар США (USD)</option>
                                <option value="eur">Евро (EUR)</option>
                                <option value="rub">Российский рубль (RUB)</option>
                            </select>
                        </div>
                        <button class="btn btn-primary w-100" id="convertBtn">Конвертировать</button>

                        <div class="result-container mt-4 text-center d-none" id="resultContainer">
                            <h3 class="mb-3">Результат конвертации</h3>
                            <div class="alert alert-info">
                                <span id="cryptoAmount" class="fw-bold"></span>
                                <span id="cryptoSymbol" class="fw-bold"></span> =
                                <span id="convertedAmount" class="fw-bold"></span>
                                <span id="currencySymbol" class="fw-bold"></span>
                            </div>
                            <p class="small text-muted">Цена обновлена: <span id="updateTime"></span></p>
                        </div>

                        <div class="alert alert-danger d-none mt-3" id="errorMessage">
                            Произошла ошибка при получении данных. Пожалуйста, попробуйте позже.
                        </div>
                    </div>
                </div>
            </div>

            <div class="mt-4">
                <h4>История конвертаций</h4>
                <div class="table-responsive">
                    <table class="table table-striped" id="historyTable">
                        <thead>
                        <tr>
                            <th>Дата/Время</th>
                            <th>Криптовалюта</th>
                            <th>Количество</th>
                            <th>Стоимость</th>
                            <th>Курс</th>
                        </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>
                <button class="btn btn-secondary" id="clearHistoryBtn">Очистить историю</button>
            </div>
        </section>
    </main>

</div>