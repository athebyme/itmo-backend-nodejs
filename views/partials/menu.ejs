<script>
    document.addEventListener('DOMContentLoaded', function() {
        const username = localStorage.getItem('username');
        if (username) {
            const mobileUsernameDisplay = document.getElementById('mobileUsernameDisplay');
            if (mobileUsernameDisplay) {
                mobileUsernameDisplay.textContent = username;
            }
        }

        const mobileLogoutLink = document.getElementById('mobileLogoutLink');
        if (mobileLogoutLink) {
            mobileLogoutLink.addEventListener('click', function(event) {
                event.preventDefault();

                localStorage.removeItem('username');
                localStorage.removeItem('isLoggedIn');

                toastr.success("Вы успешно вышли из системы.");

                setTimeout(function() {
                    window.location.replace('./');
                }, 2000);
            });
        }
    });
</script>

<script type="module">
    import authService from '/src/js/simple-auth-service.js';

    document.addEventListener('DOMContentLoaded', function() {
        // Заполняем поля текущими значениями
        const menuTenantId = document.getElementById('menuTenantId');
        const menuSupplierId = document.getElementById('menuSupplierId');

        if (menuTenantId && menuSupplierId) {
            menuTenantId.value = authService.getTenantId();
            menuSupplierId.value = authService.getSupplierId();

            // Обработчик для сохранения tenant_id
            document.getElementById('menuSaveTenantId').addEventListener('click', function() {
                const tenantId = menuTenantId.value.trim();
                if (tenantId) {
                    authService.setTenantId(tenantId);
                    if (typeof toastr !== 'undefined') {
                        toastr.success('Tenant ID сохранен');
                    }
                }
            });

            // Обработчик для сохранения supplier_id
            document.getElementById('menuSaveSupplierId').addEventListener('click', function() {
                const supplierId = menuSupplierId.value.trim();
                if (supplierId) {
                    authService.setSupplierId(supplierId);
                    if (typeof toastr !== 'undefined') {
                        toastr.success('Supplier ID сохранен');
                    }
                }
            });
        }
    });
</script>