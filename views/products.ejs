<div class="layout">
    <main class="main">
        <!-- Header Section -->
        <section class="section mb-4">
            <div class="d-flex justify-content-between align-items-center flex-wrap mb-4">
                <h2 class="section__title mb-0">Управление товарами</h2>

                <div class="d-flex gap-2 align-items-center">
                    <button id="refreshBtn" class="btn btn-outline-primary d-flex align-items-center">
                        <i class="bi bi-arrow-clockwise me-2"></i>
                        Обновить
                    </button>
                    <button id="addProductBtn" class="btn btn-primary d-flex align-items-center">
                        <i class="bi bi-plus-lg me-2"></i>
                        Добавить товар
                    </button>
                </div>
            </div>

            <!-- API Status Messages -->
            <div id="apiStatus" class="alert alert-info d-none mb-4">
                <div class="d-flex align-items-center">
                    <div class="spinner-border spinner-border-sm me-2" role="status">
                        <span class="visually-hidden">Загрузка...</span>
                    </div>
                    <span>Загрузка данных с сервера...</span>
                </div>
            </div>

            <div id="apiError" class="alert alert-danger d-none mb-4">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                <span id="errorMessage">Ошибка при загрузке данных.</span>
            </div>

            <!-- Search & Filters -->
            <div class="row filters-row">
                <div class="col-md-6 mb-3 mb-md-0">
                    <div class="input-group">
                        <span class="input-group-text bg-white">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text" id="searchInput" class="form-control" placeholder="Поиск по имени или артикулу...">
                    </div>
                </div>
                <div class="col-auto ms-auto">
                    <select id="limitSelect" class="form-select">
                        <option value="10">10 записей</option>
                        <option value="20" selected>20 записей</option>
                        <option value="50">50 записей</option>
                        <option value="100">100 записей</option>
                    </select>
                </div>
            </div>
        </section>

        <!-- Products Table Section -->
        <section class="section mb-4">
            <div class="card border-0 shadow-sm">
                <div class="table-responsive">
                    <table class="table product-table mb-0" id="productsTable">
                        <thead>
                        <tr>
                            <th>ID</th>
                            <th>Название</th>
                            <th>Цена</th>
                            <th>Описание</th>
                            <th>Создан</th>
                            <th>Обновлен</th>
                            <th>Действия</th>
                        </tr>
                        </thead>
                        <tbody>
                        <tr>
                            <td colspan="7" class="text-center">Загрузка данных...</td>
                        </tr>
                        </tbody>
                    </table>
                </div>
                <div class="card-footer bg-white py-3">
                    <div class="pagination-container">
                        <div class="page-info">
                            Показано <span id="shownCount">0</span> из <span id="totalCount">0</span> товаров
                        </div>
                        <nav aria-label="Page navigation">
                            <ul class="pagination mb-0">
                                <li class="page-item disabled">
                                    <a class="page-link" href="#" id="prevPageBtn">Предыдущая</a>
                                </li>
                                <li class="page-item disabled">
                                    <a class="page-link" href="#" id="nextPageBtn">Следующая</a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <%- include('./partials/user-session') %>

    <!-- Product Form Modal -->
    <div class="form-overlay" id="productFormOverlay">
        <div class="form-container">
            <div class="form-header">
                <h5 class="modal-title" id="productFormTitle">Добавить товар</h5>
                <button type="button" class="btn-close" id="closeFormBtn" aria-label="Close"></button>
            </div>
            <div class="form-body">
                <form id="productForm">
                    <input type="hidden" id="productId">

                    <div class="alert alert-danger d-none mb-3" id="formError">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        <span id="formErrorMessage">Ошибка при сохранении товара.</span>
                    </div>

                    <div class="mb-3">
                        <label for="productName" class="form-label">Название товара</label>
                        <input type="text" class="form-control" id="productName" required>
                        <div class="invalid-feedback">Пожалуйста, введите название товара.</div>
                    </div>

                    <div class="mb-3">
                        <label for="productPrice" class="form-label">Цена</label>
                        <div class="price-field">
                            <input type="number" class="form-control" id="productPrice" min="0" step="0.01" required>
                            <div class="invalid-feedback">Цена должна быть больше нуля.</div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="productDescription" class="form-label">Описание</label>
                        <textarea class="form-control" id="productDescription" rows="3"></textarea>
                    </div>

                    <div class="mb-3">
                        <label for="productMetadata" class="form-label">Метаданные (JSON)</label>
                        <div class="json-editor-container">
                            <textarea class="form-control" id="productMetadata" rows="4"></textarea>
                        </div>
                        <div class="invalid-feedback">Некорректный формат JSON.</div>
                        <small class="form-text text-muted">Необязательное поле. Введите дополнительные данные в формате JSON.</small>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <button type="button" class="btn btn-outline-secondary" id="cancelFormBtn">Отмена</button>
                        <button type="submit" class="btn btn-primary" id="saveProductBtn">Сохранить</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Delete Confirmation Modal -->
    <div class="form-overlay" id="deleteConfirmOverlay">
        <div class="form-container" style="max-width: 400px;">
            <div class="form-header">
                <h5 class="modal-title">Подтверждение удаления</h5>
                <button type="button" class="btn-close" id="closeDeleteConfirmBtn" aria-label="Close"></button>
            </div>
            <div class="form-body">
                <p>Вы уверены, что хотите удалить товар <strong id="deleteProductName"></strong>?</p>
                <p class="text-danger"><i class="bi bi-exclamation-triangle-fill me-2"></i>Это действие нельзя отменить.</p>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <button type="button" class="btn btn-outline-secondary" id="cancelDeleteBtn">Отмена</button>
                    <button type="button" class="btn btn-danger" id="confirmDeleteBtn">Удалить</button>
                </div>
            </div>
        </div>
    </div>
</div>