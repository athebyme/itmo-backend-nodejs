<div class="layout">
    <main class="main">
        <!-- Header Section -->
        <section class="section mb-4">
            <div class="d-flex justify-content-between align-items-center flex-wrap mb-4">
                <h2 class="section__title mb-0">Статистика изменений</h2>

                <div class="d-flex gap-2 align-items-center">
                    <div class="form-group mb-0">
                        <select id="sellerSelect" class="form-select">
                            <option value="bananzza" <%= seller === 'bananzza' ? 'selected' : '' %>>Bananzza</option>
                            <option value="lasciva" <%= seller === 'lasciva' ? 'selected' : '' %>>Lasciva</option>
                        </select>
                    </div>
                    <button id="refreshBtn" class="btn btn-primary d-flex align-items-center">
                        <i class="bi bi-arrow-clockwise me-2"></i>
                        Обновить
                    </button>
                </div>
            </div>

            <div id="apiStatus" class="alert alert-info d-none mb-4">
                <div class="d-flex align-items-center">
                    <div class="spinner-border spinner-border-sm me-2" role="status">
                        <span class="visually-hidden">Загрузка...</span>
                    </div>
                    <span>Загрузка данных с сервера...</span>
                </div>
            </div>

            <div id="apiError" class="alert alert-danger d-none mb-4">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                <span id="errorMessage">Ошибка при загрузке данных.</span>
            </div>
        </section>

        <!-- Tabbed Navigation -->
        <section class="section mb-4">
            <ul class="nav nav-tabs mb-3" id="changesTab" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="price-changes-tab" data-bs-toggle="tab" data-bs-target="#price-changes" type="button" role="tab" aria-controls="price-changes" aria-selected="true">
                        <i class="bi bi-tag me-2"></i>Изменения цен
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="stock-changes-tab" data-bs-toggle="tab" data-bs-target="#stock-changes" type="button" role="tab" aria-controls="stock-changes" aria-selected="false">
                        <i class="bi bi-box-seam me-2"></i>Изменения остатков
                    </button>
                </li>
            </ul>

            <div class="tab-content" id="changesTabContent">
                <!-- Price Changes Tab -->
                <div class="tab-pane fade show active" id="price-changes" role="tabpanel" aria-labelledby="price-changes-tab">
                    <div class="card border-0 shadow-sm mb-3">
                        <div class="card-header bg-white p-3">
                            <h5 class="card-title mb-0">Фильтры</h5>
                        </div>
                        <div class="card-body">
                            <form id="priceFilterForm" class="row g-3">
                                <div class="col-md-6 col-lg-3">
                                    <label for="priceMinChangePercent" class="form-label">Мин. изменение (%)</label>
                                    <input type="number" class="form-control" id="priceMinChangePercent" step="0.1" min="0">
                                </div>
                                <div class="col-md-6 col-lg-3">
                                    <label for="priceMaxChangePercent" class="form-label">Макс. изменение (%)</label>
                                    <input type="number" class="form-control" id="priceMaxChangePercent" step="0.1" min="0">
                                </div>
                                <div class="col-md-6 col-lg-3">
                                    <label for="priceMinChangeAmount" class="form-label">Мин. изменение (₽)</label>
                                    <input type="number" class="form-control" id="priceMinChangeAmount" min="0">
                                </div>
                                <div class="col-md-6 col-lg-3">
                                    <label for="priceSince" class="form-label">Начиная с даты</label>
                                    <input type="date" class="form-control" id="priceSince">
                                </div>
                                <div class="col-md-4 d-flex align-items-end mb-3">
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="checkbox" id="onlyPriceIncreases">
                                        <label class="form-check-label" for="onlyPriceIncreases">Только повышения</label>
                                    </div>
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="checkbox" id="onlyPriceDecreases">
                                        <label class="form-check-label" for="onlyPriceDecreases">Только понижения</label>
                                    </div>
                                </div>
                                <div class="col-md-4 d-flex align-items-end">
                                    <select id="priceLimitSelect" class="form-select">
                                        <option value="10">10 записей</option>
                                        <option value="20" selected>20 записей</option>
                                        <option value="50">50 записей</option>
                                        <option value="100">100 записей</option>
                                    </select>
                                </div>
                                <div class="col-md-4 d-flex align-items-end justify-content-end">
                                    <button type="submit" class="btn btn-primary">
                                        <i class="bi bi-filter me-2"></i>Применить фильтры
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>

                    <div class="card border-0 shadow-sm">
                        <div class="table-responsive">
                            <table class="table mb-0" id="priceChangesTable">
                                <thead>
                                <tr>
                                    <th>Товар</th>
                                    <th>Артикул</th>
                                    <th>Старая цена</th>
                                    <th>Новая цена</th>
                                    <th>Изменение</th>
                                    <th>Процент</th>
                                    <th>Дата</th>
                                </tr>
                                </thead>
                                <tbody>
                                <tr>
                                    <td colspan="7" class="text-center">Загрузка данных...</td>
                                </tr>
                                </tbody>
                            </table>
                        </div>
                        <div class="card-footer bg-white py-3">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <span class="me-2">Показано: <span id="priceShownCount">0</span> из <span id="priceTotalCount">0</span></span>
                                </div>
                                <div>
                                    <button id="priceLoadMore" class="btn btn-sm btn-outline-primary" disabled>
                                        Загрузить еще <i class="bi bi-chevron-down ms-1"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Stock Changes Tab -->
                <div class="tab-pane fade" id="stock-changes" role="tabpanel" aria-labelledby="stock-changes-tab">
                    <div class="card border-0 shadow-sm mb-3">
                        <div class="card-header bg-white p-3">
                            <h5 class="card-title mb-0">Фильтры</h5>
                        </div>
                        <div class="card-body">
                            <form id="stockFilterForm" class="row g-3">
                                <div class="col-md-6 col-lg-3">
                                    <label for="warehouseFilter" class="form-label">Склад</label>
                                    <select id="warehouseFilter" class="form-select">
                                        <option value="">Все склады</option>
                                    </select>
                                </div>
                                <div class="col-md-6 col-lg-3">
                                    <label for="stockMinChangePercent" class="form-label">Мин. изменение (%)</label>
                                    <input type="number" class="form-control" id="stockMinChangePercent" step="0.1" min="0">
                                </div>
                                <div class="col-md-6 col-lg-3">
                                    <label for="stockMinChangeAmount" class="form-label">Мин. изменение (шт)</label>
                                    <input type="number" class="form-control" id="stockMinChangeAmount" min="0">
                                </div>
                                <div class="col-md-6 col-lg-3">
                                    <label for="stockSince" class="form-label">Начиная с даты</label>
                                    <input type="date" class="form-control" id="stockSince">
                                </div>
                                <div class="col-md-4 d-flex align-items-end">
                                    <select id="stockLimitSelect" class="form-select">
                                        <option value="10">10 записей</option>
                                        <option value="20" selected>20 записей</option>
                                        <option value="50">50 записей</option>
                                        <option value="100">100 записей</option>
                                    </select>
                                </div>
                                <div class="col-md-8 d-flex align-items-end justify-content-end">
                                    <button type="submit" class="btn btn-primary">
                                        <i class="bi bi-filter me-2"></i>Применить фильтры
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>

                    <div class="card border-0 shadow-sm">
                        <div class="table-responsive">
                            <table class="table mb-0" id="stockChangesTable">
                                <thead>
                                <tr>
                                    <th>Товар</th>
                                    <th>Артикул</th>
                                    <th>Склад</th>
                                    <th>Старый остаток</th>
                                    <th>Новый остаток</th>
                                    <th>Изменение</th>
                                    <th>Процент</th>
                                    <th>Дата</th>
                                </tr>
                                </thead>
                                <tbody>
                                <tr>
                                    <td colspan="8" class="text-center">Загрузка данных...</td>
                                </tr>
                                </tbody>
                            </table>
                        </div>
                        <div class="card-footer bg-white py-3">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <span class="me-2">Показано: <span id="stockShownCount">0</span> из <span id="stockTotalCount">0</span></span>
                                </div>
                                <div>
                                    <button id="stockLoadMore" class="btn btn-sm btn-outline-primary" disabled>
                                        Загрузить еще <i class="bi bi-chevron-down ms-1"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <%- include('./partials/user-session') %>
</div>