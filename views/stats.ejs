<!-- Stats Page with SSE Integration -->
<div class="container">
    <div class="page-header">
        <li class="nav-item">
            <a class="nav-link" id="realtime-tab" data-toggle="tab" href="#realtime" role="tab">
                Мониторинг в реальном времени
            </a>
        </li>
        </ul>

        <!-- Tab content -->
        <div class="tab-content" id="statsTabContent">
            <!-- Price changes tab -->
            <div class="tab-pane fade show active" id="price-changes" role="tabpanel">
                <div class="card mt-3">
                    <div class="card-body">
                        <h5 class="card-title">Недавние изменения цен</h5>

                        <div class="table-responsive">
                            <table class="table table-striped" id="price-changes-table">
                                <thead>
                                <tr>
                                    <th>Товар</th>
                                    <th>Дата изменения</th>
                                    <th>Артикул</th>
                                    <th>Старая цена</th>
                                    <th>Новая цена</th>
                                    <th>Изменение</th>
                                    <th>Изменение %</th>
                                </tr>
                                </thead>
                                <tbody>
                                <!-- Price changes will be populated here -->
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Stock changes tab -->
            <div class="tab-pane fade" id="stock-changes" role="tabpanel">
                <div class="card mt-3">
                    <div class="card-body">
                        <h5 class="card-title">Недавние изменения остатков</h5>

                        <div class="table-responsive">
                            <table class="table table-striped" id="stock-changes-table">
                                <thead>
                                <tr>
                                    <th>Товар</th>
                                    <th>Дата изменения</th>
                                    <th>Артикул</th>
                                    <th>Склад</th>
                                    <th>Старое количество</th>
                                    <th>Новое количество</th>
                                    <th>Изменение</th>
                                    <th>Изменение %</th>
                                </tr>
                                </thead>
                                <tbody>
                                <!-- Stock changes will be populated here -->
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Real-time monitoring tab -->
            <div class="tab-pane fade" id="realtime" role="tabpanel">
                <div class="card mt-3">
                    <div class="card-body">
                        <h5 class="card-title">Мониторинг в реальном времени</h5>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="card mb-3">
                                    <div class="card-header">
                                        Журнал изменений цен
                                    </div>
                                    <div class="card-body">
                                        <div class="update-log" id="price-log">
                                            <!-- Price change logs will be added here -->
                                            <div class="update-log-entry">
                                                <span class="update-log-time">Ожидание изменений...</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="card mb-3">
                                    <div class="card-header">
                                        Журнал изменений остатков
                                    </div>
                                    <div class="card-body">
                                        <div class="update-log" id="stock-log">
                                            <!-- Stock change logs will be added here -->
                                            <div class="update-log-entry">
                                                <span class="update-log-time">Ожидание изменений...</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="card">
                            <div class="card-header">
                                Статистика подключений
                            </div>
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-6">
                                        <p>Статус подключения: <span id="connection-status">Подключение...</span></p>
                                        <p>Время с момента подключения: <span id="connection-time">0:00</span></p>
                                    </div>
                                    <div class="col-md-6">
                                        <p>Всего получено событий: <span id="total-events">0</span></p>
                                        <p>Получено изменений цен: <span id="price-events">0</span></p>
                                        <p>Получено изменений остатков: <span id="stock-events">0</span></p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div><h1>
        Статистика изменений
        <div class="sse-status sse-status-connecting">Подключение...</div>
    </h1>
</div>

<!-- Notification settings -->
<div class="card mb-4">
    <div class="card-header">
        <h5>Настройки уведомлений</h5>
    </div>
    <div class="card-body">
        <div class="notification-settings">
            <label for="notify-price">Уведомления об изменении цен</label>
            <label class="switch">
                <input type="checkbox" id="notify-price" checked>
                <span class="slider"></span>
            </label>
        </div>
        <div class="notification-settings">
            <label for="notify-stock">Уведомления об изменении остатков</label>
            <label class="switch">
                <input type="checkbox" id="notify-stock" checked>
                <span class="slider"></span>
            </label>
        </div>
        <div class="notification-settings">
            <label for="notify-sound">Звуковые уведомления</label>
            <label class="switch">
                <input type="checkbox" id="notify-sound">
                <span class="slider"></span>
            </label>
        </div>
        <div class="mt-3">
            <button class="btn btn-sm btn-outline-primary" id="test-notification">
                Проверить уведомления
            </button>
        </div>
    </div>
</div>

<!-- Tabs for different types of changes -->
<ul class="nav nav-tabs" id="statsTabs" role="tablist">
    <li class="nav-item">
        <a class="nav-link active" id="price-tab" data-toggle="tab" href="#price-changes" role="tab">
            Изменения цен
            <span class="notification-badge" data-count="0" id="price-badge"></span>
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link" id="stock-tab" data-toggle="tab" href="#stock-changes" role="tab">
            Изменения остатков
            <span class="notification-badge" data-count="0" id="stock-badge"></span>
        </a>
    </li>