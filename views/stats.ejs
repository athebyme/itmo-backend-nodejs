<!-- Stats Page with SSE Status Indicator -->
<div class="container">
    <div class="page-header">
        <h1>
            Статистика изменений
            <span class="sse-status sse-status-connecting">Подключение...</span>
        </h1>
    </div>

    <!-- Tabs for different types of changes -->
    <ul class="nav nav-tabs mb-4" id="statsTabs" role="tablist">
        <li class="nav-item">
            <a class="nav-link active" id="price-tab" data-toggle="tab" href="#price-changes" role="tab">
                Изменения цен
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" id="stock-tab" data-toggle="tab" href="#stock-changes" role="tab">
                Изменения остатков
            </a>
        </li>
    </ul>

    <!-- Tab content -->
    <div class="tab-content" id="statsTabContent">
        <!-- Price changes tab -->
        <div class="tab-pane fade show active" id="price-changes" role="tabpanel">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Недавние изменения цен</h5>

                    <div class="table-responsive">
                        <table class="table table-striped" id="price-changes-table">
                            <thead>
                            <tr>
                                <th>Товар</th>
                                <th>Дата изменения</th>
                                <th>Артикул</th>
                                <th>Старая цена</th>
                                <th>Новая цена</th>
                                <th>Изменение</th>
                                <th>Изменение %</th>
                            </tr>
                            </thead>
                            <tbody>
                            <% priceChanges.forEach(function(change) { %>
                                <tr>
                                    <td><%= change.productName %></td>
                                    <td><%= new Date(change.date).toLocaleString() %></td>
                                    <td><%= change.vendorCode %></td>
                                    <td><%= change.oldPrice.toLocaleString() %> ₽</td>
                                    <td><%= change.newPrice.toLocaleString() %> ₽</td>
                                    <td class="<%= change.changeAmount > 0 ? 'price-increase' : 'price-decrease' %>">
                                        <%= (change.changeAmount > 0 ? '+' : '') + change.changeAmount.toLocaleString() %> ₽
                                    </td>
                                    <td class="<%= change.changePercent > 0 ? 'price-increase' : 'price-decrease' %>">
                                        <%= (change.changePercent > 0 ? '+' : '') + change.changePercent.toFixed(1) %>%
                                    </td>
                                </tr>
                            <% }); %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Stock changes tab -->
        <div class="tab-pane fade" id="stock-changes" role="tabpanel">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Недавние изменения остатков</h5>

                    <div class="table-responsive">
                        <table class="table table-striped" id="stock-changes-table">
                            <thead>
                            <tr>
                                <th>Товар</th>
                                <th>Дата изменения</th>
                                <th>Артикул</th>
                                <th>Склад</th>
                                <th>Старое количество</th>
                                <th>Новое количество</th>
                                <th>Изменение</th>
                                <th>Изменение %</th>
                            </tr>
                            </thead>
                            <tbody>
                            <% stockChanges.forEach(function(change) { %>
                                <tr data-warehouse-id="<%= change.warehouseId %>">
                                    <td><%= change.productName %></td>
                                    <td><%= new Date(change.date).toLocaleString() %></td>
                                    <td><%= change.vendorCode %></td>
                                    <td><%= change.warehouseName %></td>
                                    <td><%= change.oldAmount.toLocaleString() %></td>
                                    <td class="<%= change.newAmount === 0 ? 'critical-stock' : '' %>">
                                        <%= change.newAmount.toLocaleString() %>
                                    </td>
                                    <td class="<%= change.changeAmount > 0 ? 'stock-increase' : 'stock-decrease' %>">
                                        <%= (change.changeAmount > 0 ? '+' : '') + change.changeAmount.toLocaleString() %>
                                    </td>
                                    <td class="<%= change.changePercent > 0 ? 'stock-increase' : 'stock-decrease' %>">
                                        <%= (change.changePercent > 0 ? '+' : '') + change.changePercent.toFixed(1) %>%
                                    </td>
                                </tr>
                            <% }); %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="alert alert-info mt-4">
        <p><i class="bi bi-info-circle-fill"></i> Уведомления об изменениях поступают в реальном времени. Вы можете продолжать работу на других страницах, и уведомления будут отображаться.</p>
    </div>
</div>